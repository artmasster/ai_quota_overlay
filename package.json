{
  "name": "ai-quota-overlay",
  "productName": "Ai Quota Overlay",
  "version": "1.0.0",
  "private": true,
  "description": "Tiny always-on-top rings showing how much Claude, Codex and Cursor quota you have left",
  "author": {
    "name": "artmasster",
    "email": "artmasster@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/artmasster/ai_quota_overlay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artmasster/ai_quota_overlay.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node src/check.js",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "io.github.artmasster.ai-quota-overlay",
    "productName": "Ai Quota Overlay",
    "files": ["src/**/*", "package.json"],
    "directories": { "output": "dist", "buildResources": "build" },
    "artifactName": "AiQuotaOverlay-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "AiQuotaOverlay-${version}-win-${arch}-setup.${ext}"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null,
      "extendInfo": { "LSUIElement": true }
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "artmasster <artmasster@users.noreply.github.com>"
    }
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  }
}
